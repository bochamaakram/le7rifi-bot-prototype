ENVIRONMENT=development
AUTH_MODE=dev
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
DEV_TOKEN=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# URL-encode password characters. Must match APP_DB_PASSWORD, never use postgres superuser.
DATABASE_URL=postgresql+psycopg://le7rayfi_app:CHANGE_ME@db:5432/le7rayfi
SAAS_MODE=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
LLM_MODEL=gpt-4o-mini
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
PROVIDER_TIMEOUT_SECONDS=45
MAX_AUDIO_SECONDS=60
MAX_AUDIO_BYTES=4000000
MAX_DOCUMENT_BYTES=2000000
MAX_OUTPUT_TOKENS=600
MONTHLY_UNITS_PER_USER=500
MONTHLY_UNITS_PER_TENANT=5000
MAX_REQUESTS_PER_MINUTE=20
RETENTION_DAYS=30
JWT_ISSUER=
JWT_AUDIENCE=
JWT_PUBLIC_KEY=
API_DOMAIN=localhost
